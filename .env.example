# ==========================================
# DIJITAL ASISTAN - ENVIRONMENT VARIABLES
# ==========================================

# ------------------------------------------
# SUPABASE
# ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ------------------------------------------
# GOOGLE OAUTH
# ------------------------------------------
GOOGLE_CLIENT_ID_WEB="your-google-web-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_ID_IOS="your-google-ios-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_ID_ANDROID="your-google-android-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ------------------------------------------
# MICROSOFT OAUTH
# ------------------------------------------
MICROSOFT_CLIENT_ID="your-microsoft-client-id"
MICROSOFT_CLIENT_SECRET="your-microsoft-client-secret"
MICROSOFT_TENANT_ID="common"

# ------------------------------------------
# AI PROVIDERS
# ------------------------------------------
ANTHROPIC_API_KEY="sk-ant-your-key"
OPENAI_API_KEY="sk-your-openai-key"

# ------------------------------------------
# EMBEDDINGS & VOICE
# ------------------------------------------
EMBEDDING_API_KEY="your-embedding-api-key"
TTS_API_KEY="your-tts-api-key"
STT_API_KEY="your-stt-api-key"

# ------------------------------------------
# REVENUECAT
# ------------------------------------------
REVENUECAT_PUBLIC_APPLE_API_KEY="appl_your_key"
REVENUECAT_PUBLIC_GOOGLE_API_KEY="goog_your_key"

# ------------------------------------------
# SENTRY / ANALYTICS
# ------------------------------------------
EXPO_PUBLIC_SENTRY_DSN="https://your-sentry-dsn"
NEXT_PUBLIC_ANALYTICS_ID="your-analytics-id"

# ------------------------------------------
# PUSH NOTIFICATIONS
# ------------------------------------------
EXPO_ACCESS_TOKEN="your-expo-access-token"

# ------------------------------------------
# ENCRYPTION & SECRETS
# ------------------------------------------
ENCRYPTION_KEY="32-byte-hex-string-for-local-cache"
WEBHOOK_SECRET="your-webhook-secret"

# ------------------------------------------
# APP URLS
# ------------------------------------------
NEXT_PUBLIC_APP_URL="https://dijitalasistan.app"
NEXT_PUBLIC_BACKOFFICE_URL="https://admin.dijitalasistan.app"
